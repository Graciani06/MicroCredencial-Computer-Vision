# Normaliza finales de línea: en Windows git podría convertir a CRLF y romper
# el Dockerfile (continuaciones con "\") y los scripts de shell del contenedor.
* text=auto
Dockerfile text eol=lf
*.sh       text eol=lf
*.yml      text eol=lf
*.json     text eol=lf
*.py       text eol=lf
*.cpp      text eol=lf
*.h        text eol=lf
CMakeLists.txt text eol=lf

# Binarios
*.png  binary
*.jpg  binary
*.jpeg binary
*.mp4  binary
*.avi  binary
